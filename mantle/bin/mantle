#!/usr/bin/env bash
# Copyright 2026 Ego Hygiene
# SPDX-License-Identifier: MIT
# shellcheck shell=bash
# shellcheck disable=SC2154 # Runtime or test-harness contracts inject these variables.
# shellcheck disable=SC2249 # Closed case statements intentionally treat unmatched values as no-ops.
# Public Mantle command dispatcher.

set -o errexit
set -o nounset
set -o pipefail

mantle_cli_error() {
	printf "[mantle:error] %s\n" "$*" >&2
}

mantle_cli_resolve_source() {
	local source_path="${BASH_SOURCE[0]}"
	local source_directory=""
	local link_target=""

	while [[ -L "${source_path}" ]]; do
		source_directory="$(cd -P "$(dirname -- "${source_path}")" && pwd)"
		link_target="$(readlink "${source_path}")"
		if [[ "${link_target}" == /* ]]; then
			source_path="${link_target}"
		else
			source_path="${source_directory}/${link_target}"
		fi
	done

	source_directory="$(cd -P "$(dirname -- "${source_path}")" && pwd)"
	printf "%s/%s\n" "${source_directory}" "$(basename -- "${source_path}")"
}

mantle_cli_source="$(mantle_cli_resolve_source)"
mantle_cli_bin_directory="$(dirname -- "${mantle_cli_source}")"
mantle_cli_resolved_root="$(cd -P "${mantle_cli_bin_directory}/.." && pwd)"

if [[ -n "${MANTLE_ROOT:-}" ]]; then
	if [[ "${MANTLE_ROOT}" != /* || ! -d "${MANTLE_ROOT}" ]]; then
		mantle_cli_error "MANTLE_ROOT must name an existing absolute directory"
		exit 78
	fi

	mantle_cli_configured_root="$(cd -P "${MANTLE_ROOT}" && pwd)"
	if [[ "${mantle_cli_configured_root}" != "${mantle_cli_resolved_root}" ]]; then
		mantle_cli_error "MANTLE_ROOT does not match the CLI installation root"
		mantle_cli_error "configured: ${mantle_cli_configured_root}"
		mantle_cli_error "resolved:   ${mantle_cli_resolved_root}"
		exit 78
	fi
fi

MANTLE_ROOT="${mantle_cli_resolved_root}"
export MANTLE_ROOT

if (($# == 0)); then
	set -- help
fi

case "$1" in
--help | -h)
	set -- help
	;;
--version)
	set -- version
	;;
--)
	shift
	if (($# == 0)); then
		mantle_cli_error "missing command after --"
		exit 64
	fi
	;;
-*)
	mantle_cli_error "unknown global option: $1"
	printf "Run 'mantle --help' for usage.\n" >&2
	exit 64
	;;
esac

mantle_cli_command_name="$1"
shift

if [[ ! "${mantle_cli_command_name}" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
	mantle_cli_error "invalid command name: ${mantle_cli_command_name:-<empty>}"
	exit 64
fi

mantle_cli_command_path="${MANTLE_ROOT}/libexec/mantle/commands/${mantle_cli_command_name}.sh"
if [[ ! -f "${mantle_cli_command_path}" ]]; then
	mantle_cli_error "unknown command: ${mantle_cli_command_name}"
	printf "Run 'mantle help' to list available commands.\n" >&2
	exit 64
fi
if [[ ! -x "${mantle_cli_command_path}" ]]; then
	mantle_cli_error "command implementation is not executable: ${mantle_cli_command_path}"
	exit 70
fi

MANTLE_COMMAND_NAME="${mantle_cli_command_name}"
MANTLE_COMMAND_PATH="${mantle_cli_command_path}"
export MANTLE_COMMAND_NAME MANTLE_COMMAND_PATH

exec "${mantle_cli_command_path}" "$@"
