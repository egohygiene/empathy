{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/universal.png",
    "width": null,
    "height": null,
    "padding": {
      "top": 0,
      "left": 0,
      "bottom": 0,
      "right": 5
    },
    "printRemaining": true,
    "preserveAspectRatio": true,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
  "display": {
    "stat": false,
    "pipe": false,
    "showErrors": false,
    "disableLinewrap": true,
    "hideCursor": true,
    "separator": "    ",
    "color": {
      "keys": "light_magenta",
      "title": "light_magenta",
      "output": "cyan",
      "separator": "dim_white"
    },
    "brightColor": true,
    "duration": {
      "abbreviation": true,
      "spaceBeforeUnit": "default"
    },
    "size": {
      "maxPrefix": "TB",
      "binaryPrefix": "iec",
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "temp": {
      "unit": "D",
      "ndigits": 1,
      "color": {
        "green": "green",
        "yellow": "light_yellow",
        "red": "light_red"
      },
      "spaceBeforeUnit": "default"
    },
    "percent": {
      "type": [
        "num",
        "bar",
        "num-color"
      ],
      "ndigits": 0,
      "color": {
        "green": "green",
        "yellow": "light_yellow",
        "red": "light_red"
      },
      "spaceBeforeUnit": "default",
      "width": 0
    },
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "╺",
        "right": "╸",
        "leftElapsed": "",
        "rightElapsed": ""
      },
      "color": {
        "elapsed": "light_magenta",
        "total": "dim_white",
        "border": "dim_white"
      },
      "width": 12
    },
    "fraction": {
      "ndigits": 2,
      "trailingZeros": "default"
    },
    "noBuffer": false,
    "key": {
      "width": 20,
      "type": "both-1",
      "paddingLeft": 0
    },
    "freq": {
      "ndigits": 2,
      "spaceBeforeUnit": "default"
    },
    "constants": []
  },
  "general": {
    "thread": true,
    "processingTimeout": 2500,
    "detectVersion": true,
    "playerName": ""
  },
  "modules": [
    {
      "type": "title",
      "key": " ",
      "keyIcon": "",
      "fqdn": false,
      "color": {
        "user": "light_magenta",
        "at": "dim_white",
        "host": "cyan"
      }
    },
    {
      "type": "separator",
      "string": "─",
      "outputColor": "dim_white",
      "times": 0
    },
    {
      "type": "custom",
      "key": "",
      "format": "╭─ 󰃭  SESSION",
      "outputColor": "light_magenta"
    },
    {
      "type": "datetime",
      "keyIcon": "󰃰"
    },
    {
      "type": "uptime",
      "keyIcon": "󰔟"
    },
    {
      "type": "shell",
      "keyIcon": ""
    },
    {
      "type": "terminal",
      "keyIcon": ""
    },
    {
      "type": "terminalfont",
      "keyIcon": ""
    },
    {
      "type": "terminalsize",
      "keyIcon": "󰍹"
    },
    {
      "type": "editor",
      "keyIcon": "󰏫"
    },
    {
      "type": "locale",
      "keyIcon": ""
    },
    "break",
    {
      "type": "custom",
      "key": "",
      "format": "├─ 󰍛  SYSTEM",
      "outputColor": "light_magenta"
    },
    {
      "type": "os",
      "keyIcon": ""
    },
    {
      "type": "host",
      "keyIcon": "󰌢"
    },
    {
      "type": "kernel",
      "keyIcon": ""
    },
    {
      "type": "packages",
      "keyIcon": "󰏖",
      "disabled": [
        "winget"
      ],
      "combined": true
    },
    {
      "type": "display",
      "keyIcon": "󰍹",
      "compactType": "original-with-refresh-rate",
      "preciseRefreshRate": true,
      "order": null
    },
    {
      "type": "de",
      "keyIcon": ""
    },
    {
      "type": "wm",
      "keyIcon": "",
      "detectPlugin": true
    },
    {
      "type": "wmtheme",
      "keyIcon": "󰉼"
    },
    {
      "type": "terminaltheme",
      "keyIcon": "󰔎"
    },
    "break",
    {
      "type": "custom",
      "key": "",
      "format": "├─ 󰘚  HARDWARE",
      "outputColor": "light_magenta"
    },
    {
      "type": "cpu",
      "keyIcon": "",
      "temp": false,
      "showPeCoreCount": true,
      "tempSensor": ""
    },
    {
      "type": "cpuusage",
      "keyIcon": "󰓅",
      "separate": false,
      "waitTime": 100,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "loadavg",
      "keyIcon": "󰓅"
    },
    {
      "type": "processes",
      "keyIcon": "󰐕"
    },
    {
      "type": "gpu",
      "keyIcon": "󰢮",
      "driverSpecific": false,
      "detectionMethod": "auto",
      "temp": false,
      "hideType": "none",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "memory",
      "keyIcon": "",
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "swap",
      "keyIcon": "󰓡",
      "separate": false,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "disk",
      "keyIcon": "",
      "showRegular": true,
      "showExternal": true,
      "showHidden": false,
      "showSubvolumes": false,
      "showReadOnly": false,
      "showUnknown": false,
      "useAvailable": true,
      "percent": {
        "green": 50,
        "yellow": 80,
        "type": 0
      }
    },
    {
      "type": "brightness",
      "keyIcon": "󰃠"
    },
    {
      "type": "battery",
      "keyIcon": "",
      "temp": false,
      "percent": {
        "green": 50,
        "yellow": 20,
        "type": 0
      }
    },
    {
      "type": "poweradapter",
      "keyIcon": "󰚥"
    },
    "break",
    {
      "type": "custom",
      "key": "",
      "format": "├─ 󰖩  NETWORK",
      "outputColor": "light_magenta"
    },
    {
      "type": "localip",
      "keyIcon": "󰩟",
      "showIpv4": true,
      "showIpv6": false,
      "showMac": false,
      "showLoop": false,
      "showPrefixLen": true,
      "showMtu": false,
      "showSpeed": true,
      "showFlags": false,
      "compact": false,
      "defaultRouteOnly": true,
      "showAllIps": false,
      "namePrefix": ""
    },
    {
      "type": "wifi",
      "keyIcon": "󰖩"
    },
    "break",
    {
      "type": "custom",
      "key": "",
      "format": "├─ 󰆍  DEVELOPMENT",
      "outputColor": "light_magenta"
    },
    {
      "type": "command",
      "key": "Workspace",
      "keyIcon": "󰉋",
      "shell": "/bin/sh",
      "param": "-c",
      "text": "cwd=$(pwd); shown=$cwd; case \"$cwd\" in \"$HOME\"*) shown=\"~${cwd#\"$HOME\"}\" ;; esac; if command -v git >/dev/null 2>&1 && root=$(git rev-parse --show-toplevel 2>/dev/null); then name=$(basename \"$root\"); branch=$(git branch --show-current 2>/dev/null); [ -n \"$branch\" ] || branch=$(git rev-parse --short HEAD 2>/dev/null); if [ -z \"$(git status --porcelain=v1 --untracked-files=normal 2>/dev/null)\" ]; then state=\"✓ clean\"; else state=\"● changed\"; fi; printf \"%s · %s · %s\" \"$name\" \"$branch\" \"$state\"; else printf \"%s\" \"$shown\"; fi",
      "parallel": true,
      "splitLines": false,
      "condition": {
        "!system": "Windows"
      }
    },
    {
      "type": "command",
      "key": "Toolchains",
      "keyIcon": "󰆍",
      "shell": "/bin/sh",
      "param": "-c",
      "text": "first=1; emit() { [ \"$first\" -eq 1 ] || printf \" · \"; printf \"%s\" \"$1\"; first=0; }; command -v git >/dev/null 2>&1 && emit \"$(git --version 2>/dev/null | sed \"s/^git version /git /\")\"; command -v node >/dev/null 2>&1 && emit \"$(node --version 2>/dev/null | sed \"s/^v/node /\")\"; command -v python3 >/dev/null 2>&1 && emit \"$(python3 --version 2>&1 | sed \"s/^Python /python /\")\"; command -v rustc >/dev/null 2>&1 && emit \"$(rustc --version 2>/dev/null | sed -E \"s/^rustc ([^ ]+).*/rust \\1/\")\"; command -v go >/dev/null 2>&1 && emit \"$(go version 2>/dev/null | sed -E \"s/^go version go([^ ]+).*/go \\1/\")\"; command -v task >/dev/null 2>&1 && emit \"$(task --version 2>/dev/null | sed -E \"s/^Task version: v?/task /\")\"; [ \"$first\" -eq 0 ] || printf \"none detected\"",
      "parallel": true,
      "splitLines": false,
      "condition": {
        "!system": "Windows"
      }
    },
    {
      "type": "command",
      "key": "Contexts",
      "keyIcon": "󰡨",
      "shell": "/bin/sh",
      "param": "-c",
      "text": "first=1; emit() { [ \"$first\" -eq 1 ] || printf \" · \"; printf \"%s\" \"$1\"; first=0; }; if command -v docker >/dev/null 2>&1; then value=$(docker context show 2>/dev/null); [ -z \"$value\" ] || emit \"docker $value\"; fi; if command -v kubectl >/dev/null 2>&1; then value=$(kubectl config current-context 2>/dev/null); [ -z \"$value\" ] || emit \"k8s $value\"; fi; [ \"$first\" -eq 0 ] || printf \"none active\"",
      "parallel": true,
      "splitLines": false,
      "condition": {
        "!system": "Windows"
      }
    },
    "break",
    {
      "type": "custom",
      "key": "",
      "format": "╰─ 󰎆  NOW PLAYING",
      "outputColor": "light_magenta"
    },
    {
      "type": "media",
      "keyIcon": "󰝚"
    },
    {
      "type": "player",
      "keyIcon": "󰐊"
    },
    "break",
    {
      "type": "colors",
      "key": " ",
      "keyIcon": "",
      "symbol": "block",
      "paddingLeft": 0,
      "block": {
        "width": 3,
        "range": [
          0,
          15
        ]
      },
      "brightness": "default"
    }
  ]
}
