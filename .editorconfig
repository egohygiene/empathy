root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{css,graphql,html,js,json,jsonc,jsx,md,scss,ts,tsx,yaml,yml}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bash,sh,zsh}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
