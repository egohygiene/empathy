              "shortDescription": {
                "markdown": "CVE-2026-53538: python-multipart: Semicolon treated as querystring field separator enables parameter smuggling",
                "text": "CVE-2026-53538: python-multipart: Semicolon treated as querystring field separator enables parameter smuggling"
