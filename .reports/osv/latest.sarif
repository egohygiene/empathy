              "shortDescription": {
                "markdown": "CVE-2026-86472: fast-uri vulnerable to inconsistent host case normalization via percent-encoded octets",
                "text": "CVE-2026-86472: fast-uri vulnerable to inconsistent host case normalization via percent-encoded octets"
