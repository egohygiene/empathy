              "shortDescription": {
                "markdown": "CVE-2026-112898: Pillow: Image.quantize() with empty palette leaks uninitialized stack memory",
                "text": "CVE-2026-112898: Pillow: Image.quantize() with empty palette leaks uninitialized stack memory"
