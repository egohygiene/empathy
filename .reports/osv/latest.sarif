              "shortDescription": {
                "markdown": "CVE-2026-93687: braces vulnerable to stack-exhaustion denial of service through deeply nested patterns",
                "text": "CVE-2026-93687: braces vulnerable to stack-exhaustion denial of service through deeply nested patterns"
