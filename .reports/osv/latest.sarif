              "shortDescription": {
                "markdown": "CVE-2026-14257: brace-expansion: DoS via unbounded expansion length causing an out-of-memory process crash",
                "text": "CVE-2026-14257: brace-expansion: DoS via unbounded expansion length causing an out-of-memory process crash"
