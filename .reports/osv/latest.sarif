              "id": "CVE-2026-102269",
              "name": "CVE-2026-102269",
              "properties": {
                "security-severity": "4.8"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-102269: PyJWT: Non-canonical signature segments enable raw-token revocation bypass",
                "text": "CVE-2026-102269: PyJWT: Non-canonical signature segments enable raw-token revocation bypass"
