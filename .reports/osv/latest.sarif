              "id": "CVE-2026-32630",
              "name": "CVE-2026-32630",
              "properties": {
                "security-severity": "5.3"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-32630: file-type: ZIP Decompression Bomb DoS via [Content_Types].xml entry",
                "text": "CVE-2026-32630: file-type: ZIP Decompression Bomb DoS via [Content_Types].xml entry"
              }
