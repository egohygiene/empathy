              "id": "CVE-2026-102267",
              "name": "CVE-2026-102267",
              "properties": {
                "security-severity": "7.4"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-102267: PyJWT: PyJWKClient follows redirects when fetching JWKS",
                "text": "CVE-2026-102267: PyJWT: PyJWKClient follows redirects when fetching JWKS"
              }
