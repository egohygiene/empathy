              "shortDescription": {
                "markdown": "CVE-2026-69248: python-cryptography verifier accepts wildcard DNS names allowing escape from permittedSubtrees",
                "text": "CVE-2026-69248: python-cryptography verifier accepts wildcard DNS names allowing escape from permittedSubtrees"
