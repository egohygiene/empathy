              "properties": {
                "security-severity": "5.3"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-45740: protobufjs: Denial of Service via unbounded recursive JSON descriptor expansion",
                "text": "CVE-2026-45740: protobufjs: Denial of Service via unbounded recursive JSON descriptor expansion"
              }
            },
