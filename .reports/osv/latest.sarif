              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-93981: hono/jsx renders plain strings unescaped in boundary components, leading to XSS",
                "text": "CVE-2026-93981: hono/jsx renders plain strings unescaped in boundary components, leading to XSS"
