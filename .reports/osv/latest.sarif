              "shortDescription": {
                "markdown": "CVE-2026-101908: Axios: Prototype pollution gadget in fetch adapter can alter outbound requests",
                "text": "CVE-2026-101908: Axios: Prototype pollution gadget in fetch adapter can alter outbound requests"
