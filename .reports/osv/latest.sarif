              "id": "CVE-2026-54285",
              "name": "CVE-2026-54285",
              "properties": {
                "security-severity": "5.3"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-54285: OpenTelemetry Core: Unbounded memory allocation in W3C Baggage propagation",
                "text": "CVE-2026-54285: OpenTelemetry Core: Unbounded memory allocation in W3C Baggage propagation"
              }
