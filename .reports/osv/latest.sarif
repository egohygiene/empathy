              "shortDescription": {
                "markdown": "CVE-2026-97687: urllib3: HTTPS proxy TLS configuration may be ignored or overridden",
                "text": "CVE-2026-97687: urllib3: HTTPS proxy TLS configuration may be ignored or overridden"
