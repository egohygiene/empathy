              "shortDescription": {
                "markdown": "CVE-2025-66471: urllib3 streaming API improperly handles highly compressed data",
                "text": "CVE-2025-66471: urllib3 streaming API improperly handles highly compressed data"
              }
            },
            {
              "deprecatedIds": [
                "CVE-2026-21441",
                "PYSEC-2026-1996",
                "GHSA-38jv-5279-wg99"
