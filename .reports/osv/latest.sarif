              "shortDescription": {
                "markdown": "CVE-2026-53540: python-multipart: Negative Content-Length in parse_form buffers the entire body in memory",
                "text": "CVE-2026-53540: python-multipart: Negative Content-Length in parse_form buffers the entire body in memory"
