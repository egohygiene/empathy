              "shortDescription": {
                "markdown": "CVE-2026-112902:  Pillow: Memory disclosure and segfault in libtiff encoder via crafted TIFF tags",
                "text": "CVE-2026-112902:  Pillow: Memory disclosure and segfault in libtiff encoder via crafted TIFF tags"
