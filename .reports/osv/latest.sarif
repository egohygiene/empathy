              "id": "CVE-2024-4067",
              "name": "CVE-2024-4067",
              "properties": {
                "security-severity": "5.3"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2024-4067: Regular Expression Denial of Service (ReDoS) in micromatch",
                "text": "CVE-2024-4067: Regular Expression Denial of Service (ReDoS) in micromatch"
