              "id": "CVE-2026-4539",
              "name": "CVE-2026-4539",
              "properties": {
                "security-severity": "3.3"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-4539: Pygments has Regular Expression Denial of Service (ReDoS) due to Inefficient Regex for GUID Matching",
                "text": "CVE-2026-4539: Pygments has Regular Expression Denial of Service (ReDoS) due to Inefficient Regex for GUID Matching"
