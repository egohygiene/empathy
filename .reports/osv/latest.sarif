              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-86049: Jupyter Server: 5xx request logging leaks token-bearing Referer header values",
                "text": "CVE-2026-86049: Jupyter Server: 5xx request logging leaks token-bearing Referer header values"
