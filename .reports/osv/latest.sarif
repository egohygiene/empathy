              "shortDescription": {
                "markdown": "CVE-2026-48710: BadHost: Missing Host header validation poisons request.url.path, bypassing path-based security checks",
                "text": "CVE-2026-48710: BadHost: Missing Host header validation poisons request.url.path, bypassing path-based security checks"
