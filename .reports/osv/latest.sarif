              "shortDescription": {
                "markdown": "CVE-2026-44705: tmp has Path Traversal via unsanitized prefix/postfix that enables directory escape",
                "text": "CVE-2026-44705: tmp has Path Traversal via unsanitized prefix/postfix that enables directory escape"
