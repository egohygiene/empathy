              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-102827: simple-git: unsafe-operations plugin bypass via git long-option abbreviation (--receive-p/--exe) -\u003e command execution (residual of CVE-2026-28291)",
                "text": "CVE-2026-102827: simple-git: unsafe-operations plugin bypass via git long-option abbreviation (--receive-p/--exe) -\u003e command execution (residual of CVE-2026-28291)"
