              "shortDescription": {
                "markdown": "CVE-2026-48524: PyJWKClient unbounded JWKS endpoint requests via attacker-controlled kid values (DoS)",
                "text": "CVE-2026-48524: PyJWKClient unbounded JWKS endpoint requests via attacker-controlled kid values (DoS)"
              }
