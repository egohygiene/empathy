ly needed to switch to these two unprivileged uids\nVIRTUALENV = [\"virtualenv\", \"--quiet\", \"--no-periodic-update\"]  # default seeder; no network for the update check\n# read here, as root: /tmp/repro.d need not be readable by the other user\nATTACK = Path(\"/tmp/repro.d/other_user_appends_to_pip.py\").read_text()\n\n\ndef run_as_owner(command, home, umask):\n    environ = {\"HOME\": str(home), \"PATH\": os.environ[\"PATH\"]}\n    subprocess.run(command, user=OWNER, group=OWNER, extra_groups=[], umask=umask, env=environ, cwd=home, check=True)\n\n\ndef mode(path):\n    return stat.filemode(os.stat(path).st_mode)\n\n\nwork = Path(\"/tmp/seed-mode-repro\")\nshutil.rmtree(work, ignore_errors=True)\nwork.mkdir()\nproofs = work / \"proofs\"\nproofs.mkdir()\nproofs.chmod(0o777)  # the other user's line writes the uid it runs as in here\n\nwritable_by_others, appended_line_ran_as = {}, {}\n# the two histories differ only in the umask of the owner's earlier run, the one that fills ~/.cache/virtualenv\nfor case, umask_of_earlier_run in [(\"CONTROL\", 0o022), (\"OBSERVED\", 0o000)]:\n    # set up: the owner's home, and with it the cache, is private; the project folder is reachable by path\n    home = work / f\"{case}-home\"\n    home.mkdir(mode=0o700)\n    os.chown(home, OWNER, OWNER)\n    projects = work / f\"{case}-projects\"\n    projects.mkdir(mode=0o755)\n    os.chown(projects, OWNER, OWNER)\n\n    # owner, some time ago: the first run, with an empty cache, extracts the pip wheel into it\n    run_as_owner([*VIRTUALENV, str(home / \"earlier-env\")], home, umask=umask_of_earlier_run)\n    # owner, today\n    env = projects / \"env\"\n    run_as_owner([*VIRTUALENV, str(env)], home, umask=0o022)\n\n    (cached_pip,) = glob.glob(f\"{home}/.cache/virtualenv/wheel/*/image/1/CopyPipInstall/pip-*/pip/__init__.py\")\n    (seeded_pip,) = glob.glob(f\"{env}/lib/python*/site-packages/pip/__init__.py\")\n    env_files = [path for path in env.rglob(\"*\") if path.is_file() and not path.is_symlink()]\n    writable_by_others[case] = sum(1 for path in env_files if path.stat().st_mode \u0026 stat.S_IWOTH)\n    print(f\"{case} earlier run under umask {umask_of_earlier_run:03o}, env created under umask 022\")\n    print(f\"{case}   cache pip/__init__.py  {mode(cached_pip)}\")\n    print(f\"{case}   env   pyvenv.cfg       {mode(env / 'pyvenv.cfg')}\")\n    print(f\"{case}   env   bin/activate     {mode(env / 'bin' / 'activate')}\")\n    print(f\"{case}   env   pip/__init__.py  {mode(seeded_pip)}\")\n    print(f\"{case}   env files writable by others: {writable_by_others[case]} of {len(env_files)}\")\n\n    # attack: another local user appends a line to the owner's seeded pip\n    proof = proofs / case\n    subprocess.run(\n        [\"python3\", \"-\", str(env), str(proof)],\n        input=ATTACK,\n        text=True,\n        user=OTHER_USER,\n        group=OTHER_USER,\n        extra_groups=[],\n        env={\"PATH\": os.environ[\"PATH\"]},\n        cwd=\"/\",\n        check=True,\n    )\n\n    # the owner uses the environment\n    run_as_owner([str(env / \"bin\" / \"pip\"), \"--version\"], home, umask=0o022)\n    appended_line_ran_as[case] = proof.read_text() if proof.exists() else None\n    print(f\"{case}   other user's line ran as uid: {appended_line_ran_as[case]}\")\n\n# check: the same umask 022 today must give the same modes, whatever umask filled the cache earlier\ncontrol_is_private = writable_by_others[\"CONTROL\"] == 0 and appended_line_ran_as[\"CONTROL\"] is None\nobserved_runs_as_owner = writable_by_others[\"OBSERVED\"] \u003e 0 and appended_line_ran_as[\"OBSERVED\"] == str(OWNER)\nprint(\"BUG\" if control_is_private and observed_runs_as_owner else \"OK\")\n```\n\n**`repro.d/other_user_appends_to_pip.py`**\n\n```text\nimport glob\nimport sys\n\nenvironment, proof = sys.argv[1:]\n(pip_init,) = glob.glob(f\"{environment}/lib/python*/site-packages/pip/__init__.py\")\nadded_line = f\"\\nimport os; open({proof!r}, 'w').write(str(os.getuid()))