              "id": "CVE-2026-84947",
              "name": "CVE-2026-84947",
              "properties": {
                "security-severity": "3.7"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-84947: undici vulnerable to response truncation via oversized chunked responses in the dump interceptor",
                "text": "CVE-2026-84947: undici vulnerable to response truncation via oversized chunked responses in the dump interceptor"
