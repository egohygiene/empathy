              "id": "CVE-2026-104854",
              "name": "CVE-2026-104854",
              "properties": {
                "security-severity": "8.5"
              },
              "relationships": [],
              "shortDescription": {
                "markdown": "CVE-2026-104854: Nx daemon and plugin worker sockets are accessible to other local users",
