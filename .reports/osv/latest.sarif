              "shortDescription": {
                "markdown": "CVE-2026-111766: markdown-it: Quadratic-time denial of service in inline HTML parsing with html enabled",
                "text": "CVE-2026-111766: markdown-it: Quadratic-time denial of service in inline HTML parsing with html enabled"
