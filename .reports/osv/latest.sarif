              "shortDescription": {
                "markdown": "CVE-2026-112899: Pillow: EPS load(scale) lets Ghostscript render past the decompression bomb limit",
                "text": "CVE-2026-112899: Pillow: EPS load(scale) lets Ghostscript render past the decompression bomb limit"
              }
