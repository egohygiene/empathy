# ==============================================================================
# Ego Hygiene - TruffleHog Filesystem Exclusions
# ==============================================================================
#
# Each non-comment line is a regular expression matched against scanned paths.
# Keep this list narrow: exclusions can hide committed credentials.
# ==============================================================================

(^|/)\.git/
(^|/)node_modules/
(^|/)vendor/

(^|/)\.venv/
(^|/)venv/
(^|/)__pycache__/

(^|/)\.cache/
(^|/)\.next/
(^|/)\.nuxt/
(^|/)\.turbo/
(^|/)\.pnpm-store/
(^|/)\.yarn/

(^|/)build/
(^|/)dist/
(^|/)out/
(^|/)target/
(^|/)coverage/
(^|/)generated/
(^|/)tmp/

^\.reports/
^egolint/tests/fixtures/negative/

# test_quality_policy.py contains test function names (e.g.
# test_commit_tools_share_the_emoji_policy) that match the Lob API key pattern
# as a false positive. The file contains only policy assertions, no credentials.
^tests/test_quality_policy\.py$

\.map$
\.min\.js$
\.min\.css$
\.snap$
