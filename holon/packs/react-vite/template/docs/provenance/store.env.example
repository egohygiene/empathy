# The app starts in mock mode and requires no credentials.
VITE_COMMERCE_PROVIDER=mock

# Fourthwall Storefront API configuration.
VITE_FOURTHWALL_STOREFRONT_TOKEN=
VITE_FOURTHWALL_CHECKOUT_DOMAIN=

# Storefront behavior.
VITE_STORE_CURRENCY=USD
VITE_STORE_BASE_PATH=/store/
VITE_STORE_NAME=ego hygiene store
VITE_STORE_HOME_URL=https://egohygiene.io/
