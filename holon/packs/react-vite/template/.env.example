# All VITE_* variables are copied into browser bundles and are public.
# Never put API secrets, private keys, or privileged provider tokens here.

# Shared local server and build behavior.
VITE_DEV_HOST=127.0.0.1
# VITE_DEV_PORT=5173
# VITE_PREVIEW_HOST=127.0.0.1
# VITE_PREVIEW_PORT=4173
# VITE_BASE_PATH=/

# Build-time switches are consumed by Vite config and are not client globals.
TEMPLATE_ANALYZE=false
TEMPLATE_SOURCE_MAPS=false
TEMPLATE_PWA_DEV=false

# The commerce profile starts in mock mode and requires no credentials.
VITE_COMMERCE_PROVIDER=mock
VITE_FOURTHWALL_STOREFRONT_TOKEN=
VITE_FOURTHWALL_CHECKOUT_DOMAIN=
VITE_STORE_CURRENCY=USD
VITE_STORE_BASE_PATH=/store/
VITE_STORE_NAME=Ego Hygiene Store
VITE_STORE_HOME_URL=https://egohygiene.io/
